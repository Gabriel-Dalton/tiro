<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows shell around the web core (SPEC-WINDOWS.md). The host frame is
       WinForms rather than WinUI 3: it gives NotifyIcon + WebView2 with a plain
       csproj and, unlike the Windows App SDK, publishes to a genuine single
       self-contained EXE in CI. All product UI is still the web core; the native
       layer is only the hook, SendInput, tray and storage, exactly the split
       the spec draws. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tiro</AssemblyName>
    <RootNamespace>Tiro.Windows</RootNamespace>
    <ApplicationIcon>Assets\tiro.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Version.props is generated from the VERSION file at the repository root, so
       the EXE, the web core and the landing page always quote the same number. -->
  <Import Project="Version.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- the web core ships verbatim next to the EXE; the PWA and this app are the same product -->
    <Content Include="..\..\web\**\*" Exclude="..\..\web\vercel.json"
             Link="web\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
