.build/
Tiro.app/
.DS_Store
public/
.vercel/
# README tells you to `npm install --no-save playwright` in the repo root to run
# scripts/smoke-web.mjs, which leaves this behind. --no-save keeps it out of a
# package.json we do not have; this keeps it out of a commit.
node_modules/

# the local copy of smoke-web.mjs used to point Playwright at a system Chromium
scripts/smoke.local.mjs

# What building the Windows app leaves behind. docs/PACKAGING.md hands you the
# publish command and the standalone folder, and the EXE in them is 50 MB, which
# is worth keeping well away from anything that might stage it by accident.
windows/**/bin/
windows/**/obj/
publish/
standalone/
